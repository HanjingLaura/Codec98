# ===== 老板话术解码器 配置 =====
# 复制本文件为 .env 并填入你的 key

# 阿里云百炼（DashScope）API Key —— 推荐，国内直连
# 获取: https://bailian.console.aliyun.com/ → API-KEY管理
DASHSCOPE_API_KEY=

# 百炼模型名（默认 qwen-plus，可换 qwen-max / qwen-turbo）
MODEL_NAME=qwen-plus

# 备选：Anthropic API Key（设了 DASHSCOPE_API_KEY 时优先走百炼）
ANTHROPIC_API_KEY=

# 端口（本机3000被占用，建议3210）
PORT=3210
